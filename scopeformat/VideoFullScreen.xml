<?xml version="1.0" encoding="UTF-8"?>
<window>
	<include>ProjectorAlignCoordinates</include>
	<defaultcontrol>-</defaultcontrol>
	<onload>Skin.Reset(osd169)</onload>
	<onload condition="!Skin.HasSetting(rememberScopeMaskSetting)">Skin.Reset(scopemask)</onload>
	<onload>Action(AspectRatio)</onload>
	<onload condition="String.StartsWith(Player.Process(VideoDAR),2.2) | String.StartsWith(Player.Process(VideoDAR),2.3) | String.StartsWith(Player.Process(VideoDAR),2.4) | String.StartsWith(Player.Process(VideoDAR),2.5) | String.StartsWith(Player.Process(VideoDAR),2.6) | String.StartsWith(Player.Process(VideoDAR),2.7) | String.StartsWith(Player.Process(VideoDAR),2.8) | String.StartsWith(Player.Process(VideoDAR),2.9) | String.StartsWith(Player.Process(VideoDAR),3.)">
		Skin.SetBool(scopemask)
	</onload>
	<!-- AutoZoom (scripts/autozoom.py): saved per-movie zoom, else fit to the scope frame; once per file -->
	<onload>RunScript(special://skin/scripts/autozoom.py,apply)</onload>
	<onunload condition="!Player.HasMedia">ClearProperty(ScopeNox.AutoZoom.Applied,Home)</onunload>
	<onunload condition="!Player.HasMedia">ClearProperty(ScopeNox.AutoZoom.Saved,Home)</onunload>
	<controls>
		<!-- codec info -->
		<control type="group" id="0">
			<animation effect="fade" time="200">WindowOpen</animation>
			<animation effect="fade" time="200">WindowClose</animation>
			<control type="grouplist" id="0">
				<left>30</left>
				<width>100%</width>
				<height>300</height>
				<itemgap>10</itemgap>
				<control type="label" id="10">
					<description>row 1 label</description>
					<width>1770</width>
					<height>90</height>
					<font>font14</font>
					<textcolor>grey2</textcolor>
					<shadowcolor>shadow</shadowcolor>
					<label />
				</control>
				<control type="label" id="11">
					<description>row 2 label</description>
					<width>1770</width>
					<height>90</height>
					<font>font14</font>
					<label />
					<textcolor>grey2</textcolor>
					<shadowcolor>shadow</shadowcolor>
				</control>
				<control type="label" id="12">
					<description>row 3 label</description>
					<width>1770</width>
					<height>90</height>
					<font>font14</font>
					<label />
					<textcolor>grey2</textcolor>
					<shadowcolor>shadow</shadowcolor>
				</control>
			</control>
		</control>
		<control type="label" id="1">
			<description>seek label</description>
			<width>100%</width>
			<height>100%</height>
			<align>center</align>
			<aligny>center</aligny>
			<font>font_MainMenu</font>
			<shadowcolor>shadow</shadowcolor>
			<label>$INFO[Player.SeekNumeric]</label>
		</control>
	</controls>
</window>
