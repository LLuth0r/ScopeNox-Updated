<?xml version="1.0" encoding="UTF-8"?>
<!-- "Dock" home menu style (Skin Settings > Home window > Home menu style): a square-cornered glass bar on the bottom edge of
     the frame with an icon and a label per home item. Textures: tools/gendock.ps1 -> media/dock/.
     Skin.String(HomeMenuStyle): empty = classic bar, dock = dark glass, docklight = light glass. -->
<includes>
	<variable name="HomeMenuStyleVar">
		<value condition="String.IsEqual(Skin.String(HomeMenuStyle),dock)">$LOCALIZE[31985]</value>
		<value condition="String.IsEqual(Skin.String(HomeMenuStyle),docklight)">$LOCALIZE[31986]</value>
		<value>$LOCALIZE[31984]</value>
	</variable>
	<!-- Home Menu Customizer: the dock icon picked for the selected item -->
	<variable name="DockIconChoiceVar">
		<value condition="!String.IsEmpty(Container(90000).ListItem.Property(DockIcon))">$INFO[Container(90000).ListItem.Property(DockIconLabel)]</value>
		<value>$LOCALIZE[571]</value>
	</variable>
	<variable name="DockClockVar">
		<value condition="!Skin.HasSetting(Dock.HideDate) + !Skin.HasSetting(Dock.HideTime)">$INFO[System.Date,[COLOR CCffffff],[/COLOR][COLOR 99ffffff]  |  [/COLOR]]$INFO[System.Time]</value>
		<value condition="!Skin.HasSetting(Dock.HideDate)">$INFO[System.Date]</value>
		<value>$INFO[System.Time]</value>
	</variable>
	<variable name="DockTextureVar">
		<value condition="String.IsEqual(Skin.String(HomeMenuStyle),docklight)">dock/light/</value>
		<value>dock/dark/</value>
	</variable>
	<variable name="DockIconColorVar">
		<value condition="String.IsEqual(Skin.String(HomeMenuStyle),docklight)">D91c1c1e</value>
		<value>F2ffffff</value>
	</variable>
	<variable name="DockLabelColorVar">
		<value condition="String.IsEqual(Skin.String(HomeMenuStyle),docklight)">CC1c1c1e</value>
		<value>D9ffffff</value>
	</variable>
	<variable name="DockFocusedIconColorVar">
		<value condition="String.IsEqual(Skin.String(HomeMenuStyle),docklight)">FF1c1c1e</value>
		<value>themecolor</value>
	</variable>
	<variable name="DockFocusedLabelColorVar">
		<value condition="String.IsEqual(Skin.String(HomeMenuStyle),docklight)">FF1c1c1e</value>
		<value>FFffffff</value>
	</variable>
	<!-- icon picked in the Home Menu Customizer (scripts/dockicon.py), else by home item type (ListItem.Property(Item)) -->
	<variable name="DockIconVar">
		<value condition="!String.IsEmpty(ListItem.Property(DockIcon))">$INFO[ListItem.Property(DockIcon)]</value>
		<value condition="String.IsEqual(ListItem.Property(Item),Movie)">dock/icons/movie.png</value>
		<value condition="String.IsEqual(ListItem.Property(Item),TVShow)">dock/icons/tvshow.png</value>
		<value condition="String.IsEqual(ListItem.Property(Item),LiveTV)">dock/icons/livetv.png</value>
		<value condition="String.IsEqual(ListItem.Property(Item),Music)">dock/icons/music.png</value>
		<value condition="String.IsEqual(ListItem.Property(Item),MusicVideo)">dock/icons/musicvideo.png</value>
		<value condition="String.IsEqual(ListItem.Property(Item),Pictures)">dock/icons/pictures.png</value>
		<value condition="String.IsEqual(ListItem.Property(Item),Videos)">dock/icons/videos.png</value>
		<value condition="String.IsEqual(ListItem.Property(Item),Programs)">dock/icons/programs.png</value>
		<value condition="String.IsEqual(ListItem.Property(Item),Games)">dock/icons/games.png</value>
		<value condition="String.IsEqual(ListItem.Property(Item),Favorites)">dock/icons/favorites.png</value>
		<value condition="String.IsEqual(ListItem.Property(Item),Weather)">dock/icons/weather.png</value>
		<value condition="String.IsEqual(ListItem.Property(Item),Settings)">dock/icons/settings.png</value>
		<value condition="String.IsEqual(ListItem.Property(Item),Shutdown)">dock/icons/shutdown.png</value>
		<value>dock/icons/custom.png</value>
	</variable>
	<include name="HomeDock">
		<control type="group">
			<animation type="WindowOpen" reversible="false">
				<effect type="slide" start="0,100" end="0,0" time="320" tween="cubic" easing="out" />
				<effect type="fade" start="0" end="100" time="260" />
			</animation>
			<animation type="WindowClose" reversible="false">
				<effect type="slide" start="0,0" end="0,100" time="220" tween="cubic" easing="in" />
				<effect type="fade" start="100" end="0" time="220" />
			</animation>
			<!-- date and time, top right of the frame (Skin Settings > Home window > Show date / Show time) -->
			<control type="label">
				<right>60</right>
				<top>160</top>
				<width>900</width>
				<height>40</height>
				<align>right</align>
				<font>font12_title</font>
				<textcolor>white</textcolor>
				<shadowcolor>shadow</shadowcolor>
				<label>$VAR[DockClockVar]</label>
				<visible>!Skin.HasSetting(Dock.HideDate) | !Skin.HasSetting(Dock.HideTime)</visible>
			</control>
			<!-- the dock sits flush on the bottom edge of the frame: y 940 for 2.40, 950 for 2.35 -->
			<control type="group">
				<animation effect="slide" end="0,10" time="0" condition="Skin.HasSetting(scopeFormat235)">Conditional</animation>
				<!-- submenu of the focused dock item: a full-width glass footer on the bottom edge of the frame, entries
				     starting under the dock's left edge. Always shown with Skin Settings > Home window > Submenu always
				     visible (the dock then sits above it); otherwise Down from the dock slides the dock up and shows it, Up
				     goes back. Entries are filtered on the focused dock item, so Container(9010).NumItems is useless here. -->
				<control type="group">
					<!-- hidden with an animation, not <visible>: Kodi doesn't process hidden lists, so the entries
					     (filtered on the focused dock item) would never update -->
					<animation effect="fade" start="100" end="0" time="160" condition="![Skin.HasSetting(Enable.VisibleSubmenu) | Control.HasFocus(9010)]">Conditional</animation>
					<animation effect="slide" start="0,0" end="0,24" time="200" tween="cubic" easing="inout" condition="![Skin.HasSetting(Enable.VisibleSubmenu) | Control.HasFocus(9010)]">Conditional</animation>
					<control type="image">
						<left>0</left>
						<top>872</top>
						<width>1920</width>
						<height>68</height>
						<texture border="0,24,0,4">$VAR[DockTextureVar]tile.png</texture>
					</control>
					<control type="list" id="9010">
						<left>240</left>
						<top>892</top>
						<width>1600</width>
						<height>48</height>
						<orientation>horizontal</orientation>
						<onup>9000</onup>
						<scrolltime tween="quadratic" easing="out">200</scrolltime>
						<!-- line up with the dock, which is centred for its number of items -->
						<animation effect="slide" end="660,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,1)">Conditional</animation>
						<animation effect="slide" end="600,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,2)">Conditional</animation>
						<animation effect="slide" end="540,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,3)">Conditional</animation>
						<animation effect="slide" end="480,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,4)">Conditional</animation>
						<animation effect="slide" end="420,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,5)">Conditional</animation>
						<animation effect="slide" end="360,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,6)">Conditional</animation>
						<animation effect="slide" end="300,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,7)">Conditional</animation>
						<animation effect="slide" end="240,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,8)">Conditional</animation>
						<animation effect="slide" end="180,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,9)">Conditional</animation>
						<animation effect="slide" end="120,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,10)">Conditional</animation>
						<animation effect="slide" end="60,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,11)">Conditional</animation>
						<itemlayout width="180" height="48">
							<control type="label">
								<width>180</width>
								<height>48</height>
								<font>font14</font>
								<align>center</align>
								<aligny>center</aligny>
								<textcolor>$VAR[DockLabelColorVar]</textcolor>
								<label>$INFO[ListItem.Label]</label>
							</control>
						</itemlayout>
						<focusedlayout width="180" height="48">
							<control type="group">
								<visible>Control.HasFocus(9010)</visible>
								<animation type="Focus">
									<effect type="fade" start="0" end="100" time="160" />
								</animation>
								<control type="image">
									<left>2</left>
									<top>4</top>
									<width>176</width>
									<height>42</height>
									<texture border="4">$VAR[DockTextureVar]lens.png</texture>
								</control>
								<control type="image">
									<left>66</left>
									<top>4</top>
									<width>48</width>
									<height>3</height>
									<texture>dock/accent.png</texture>
									<colordiffuse>themecolor</colordiffuse>
								</control>
							</control>
							<control type="label">
								<width>180</width>
								<height>48</height>
								<font>font14</font>
								<align>center</align>
								<aligny>center</aligny>
								<textcolor>$VAR[DockLabelColorVar]</textcolor>
								<label>$INFO[ListItem.Label]</label>
								<visible>!Control.HasFocus(9010)</visible>
							</control>
							<control type="label">
								<width>180</width>
								<height>48</height>
								<font>font14</font>
								<align>center</align>
								<aligny>center</aligny>
								<textcolor>$VAR[DockFocusedLabelColorVar]</textcolor>
								<label>$INFO[ListItem.Label]</label>
								<scroll>true</scroll>
								<visible>Control.HasFocus(9010)</visible>
							</control>
						</focusedlayout>
						<include condition="!System.HasAddon(script.skinshortcuts)">FallbackSubMenu</include>
						<include condition="System.HasAddon(script.skinshortcuts)">CustomSubMenu</include>
					</control>
				</control>
				<!-- the dock: above the submenu footer while it shows -->
				<control type="group">
					<animation effect="slide" start="0,0" end="0,-48" time="220" tween="cubic" easing="inout" condition="[Skin.HasSetting(Enable.VisibleSubmenu) | Control.HasFocus(9010)]">Conditional</animation>
				<!-- glass bar sized for the number of items (9-slice; shadow left/top/right only) -->
				<control type="image">
					<left>868</left>
					<top>840</top>
					<width>184</width>
					<height>100</height>
					<texture border="24,24,24,4">$VAR[DockTextureVar]bar.png</texture>
					<visible>Integer.IsEqual(Container(9000).NumItems,1)</visible>
				</control>
				<control type="image">
					<left>808</left>
					<top>840</top>
					<width>304</width>
					<height>100</height>
					<texture border="24,24,24,4">$VAR[DockTextureVar]bar.png</texture>
					<visible>Integer.IsEqual(Container(9000).NumItems,2)</visible>
				</control>
				<control type="image">
					<left>748</left>
					<top>840</top>
					<width>424</width>
					<height>100</height>
					<texture border="24,24,24,4">$VAR[DockTextureVar]bar.png</texture>
					<visible>Integer.IsEqual(Container(9000).NumItems,3)</visible>
				</control>
				<control type="image">
					<left>688</left>
					<top>840</top>
					<width>544</width>
					<height>100</height>
					<texture border="24,24,24,4">$VAR[DockTextureVar]bar.png</texture>
					<visible>Integer.IsEqual(Container(9000).NumItems,4)</visible>
				</control>
				<control type="image">
					<left>628</left>
					<top>840</top>
					<width>664</width>
					<height>100</height>
					<texture border="24,24,24,4">$VAR[DockTextureVar]bar.png</texture>
					<visible>Integer.IsEqual(Container(9000).NumItems,5)</visible>
				</control>
				<control type="image">
					<left>568</left>
					<top>840</top>
					<width>784</width>
					<height>100</height>
					<texture border="24,24,24,4">$VAR[DockTextureVar]bar.png</texture>
					<visible>Integer.IsEqual(Container(9000).NumItems,6)</visible>
				</control>
				<control type="image">
					<left>508</left>
					<top>840</top>
					<width>904</width>
					<height>100</height>
					<texture border="24,24,24,4">$VAR[DockTextureVar]bar.png</texture>
					<visible>Integer.IsEqual(Container(9000).NumItems,7)</visible>
				</control>
				<control type="image">
					<left>448</left>
					<top>840</top>
					<width>1024</width>
					<height>100</height>
					<texture border="24,24,24,4">$VAR[DockTextureVar]bar.png</texture>
					<visible>Integer.IsEqual(Container(9000).NumItems,8)</visible>
				</control>
				<control type="image">
					<left>388</left>
					<top>840</top>
					<width>1144</width>
					<height>100</height>
					<texture border="24,24,24,4">$VAR[DockTextureVar]bar.png</texture>
					<visible>Integer.IsEqual(Container(9000).NumItems,9)</visible>
				</control>
				<control type="image">
					<left>328</left>
					<top>840</top>
					<width>1264</width>
					<height>100</height>
					<texture border="24,24,24,4">$VAR[DockTextureVar]bar.png</texture>
					<visible>Integer.IsEqual(Container(9000).NumItems,10)</visible>
				</control>
				<control type="image">
					<left>268</left>
					<top>840</top>
					<width>1384</width>
					<height>100</height>
					<texture border="24,24,24,4">$VAR[DockTextureVar]bar.png</texture>
					<visible>Integer.IsEqual(Container(9000).NumItems,11)</visible>
				</control>
				<control type="image">
					<left>208</left>
					<top>840</top>
					<width>1504</width>
					<height>100</height>
					<texture border="24,24,24,4">$VAR[DockTextureVar]bar.png</texture>
					<visible>Integer.IsEqual(Container(9000).NumItems,12)</visible>
				</control>
				<control type="list" id="9000">
					<left>240</left>
					<top>860</top>
					<width>1440</width>
					<height>80</height>
					<orientation>horizontal</orientation>
					<ondown>9010</ondown>
					<scrolltime tween="quadratic" easing="out">200</scrolltime>
					<!-- centre the items: the list is 12 items wide -->
					<animation effect="slide" end="660,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,1)">Conditional</animation>
					<animation effect="slide" end="600,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,2)">Conditional</animation>
					<animation effect="slide" end="540,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,3)">Conditional</animation>
					<animation effect="slide" end="480,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,4)">Conditional</animation>
					<animation effect="slide" end="420,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,5)">Conditional</animation>
					<animation effect="slide" end="360,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,6)">Conditional</animation>
					<animation effect="slide" end="300,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,7)">Conditional</animation>
					<animation effect="slide" end="240,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,8)">Conditional</animation>
					<animation effect="slide" end="180,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,9)">Conditional</animation>
					<animation effect="slide" end="120,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,10)">Conditional</animation>
					<animation effect="slide" end="60,0" time="0" condition="Integer.IsEqual(Container(9000).NumItems,11)">Conditional</animation>
					<itemlayout width="120" height="80">
						<control type="image">
							<left>43</left>
							<top>10</top>
							<width>34</width>
							<height>34</height>
							<texture>$VAR[DockIconVar]</texture>
							<colordiffuse>$VAR[DockIconColorVar]</colordiffuse>
						</control>
						<control type="label">
							<top>45</top>
							<width>120</width>
							<height>26</height>
							<font>font14</font>
							<align>center</align>
							<textcolor>$VAR[DockLabelColorVar]</textcolor>
							<label>$INFO[ListItem.Label]</label>
						</control>
					</itemlayout>
					<focusedlayout width="120" height="80">
						<control type="group">
							<visible>Control.HasFocus(9000)</visible>
							<animation type="Focus">
								<effect type="fade" start="0" end="100" time="160" />
							</animation>
							<control type="image">
								<left>2</left>
								<top>4</top>
								<width>116</width>
								<height>74</height>
								<texture border="4">$VAR[DockTextureVar]lens.png</texture>
							</control>
							<control type="image">
								<left>36</left>
								<top>4</top>
								<width>48</width>
								<height>3</height>
								<texture>dock/accent.png</texture>
								<colordiffuse>themecolor</colordiffuse>
							</control>
						</control>
						<control type="image">
							<left>43</left>
							<top>10</top>
							<width>34</width>
							<height>34</height>
							<texture>$VAR[DockIconVar]</texture>
							<colordiffuse>$VAR[DockFocusedIconColorVar]</colordiffuse>
						</control>
						<control type="label">
							<top>45</top>
							<width>120</width>
							<height>26</height>
							<font>font14</font>
							<align>center</align>
							<textcolor>$VAR[DockFocusedLabelColorVar]</textcolor>
							<scroll>true</scroll>
							<label>$INFO[ListItem.Label]</label>
						</control>
					</focusedlayout>
					<include>FallbackMenu</include>
				</control>
				</control>
			</control>
		</control>
	</include>
</includes>