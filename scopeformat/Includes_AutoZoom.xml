		<onclick>Action(subtitleshiftdown)</onclick>
		<onclick>Action(subtitleshiftdown)</onclick>
		<onclick>Action(subtitleshiftdown)</onclick>
		<onclick>Action(subtitleshiftdown)</onclick>
		<onclick>Action(subtitleshiftdown)</onclick>
		<onclick>Action(subtitleshiftdown)</onclick>
	</include>
	<include name="SubShiftUpClick">
		<include>SubShiftUp10</include>
