<?xml version="1.0" encoding="UTF-8"?>
<!--
	AutoZoom: zoom 16:9 (and 1.33 - 2.19) content out so it fits inside the scope frame.

	Kodi's zoomout/zoomin actions are relative (+/-0.01) and Kodi restores the zoom it saved for a file
	on the next play, so stepping down from "wherever it is now" drifts lower on every replay.
	Instead we first zoom out 150 steps, which always clamps at Kodi's minimum of 0.50, then zoom
	in a fixed number of steps to reach an absolute target.

	Targets (zoom = frame height / displayed height, using the middle of each DAR bucket):
	  DAR        2.40 format        2.35 format
	  <= 1.79    0.74 (24 steps)    0.76 (26 steps)
	  1.8x       0.77 (27 steps)    0.79 (29 steps)
	  1.9x       0.81 (31 steps)    0.83 (33 steps)
	  2.0x       0.85 (35 steps)    0.87 (37 steps)
	  2.1x       0.90 (40 steps)    0.91 (41 steps)
	2.20 and wider is not zoomed (it gets the scope mask instead).

	Kodi evaluates every onload condition before running any of them, so the zoom steps and the
	final Skin.SetString(autozoomfile) all see the same state.
-->
<includes>
	<!-- AutoZoom is on, hasn't run for this file yet, and the stream is 1.00 - 2.19 -->
	<expression name="AutoZoomRun">Skin.HasSetting(enableAutoZoom) + !String.IsEqual(Skin.String(autozoomfile),Player.Filenameandpath) + [String.StartsWith(Player.Process(VideoDAR),1.0) | String.StartsWith(Player.Process(VideoDAR),1.1) | String.StartsWith(Player.Process(VideoDAR),1.2) | String.StartsWith(Player.Process(VideoDAR),1.3) | String.StartsWith(Player.Process(VideoDAR),1.4) | String.StartsWith(Player.Process(VideoDAR),1.5) | String.StartsWith(Player.Process(VideoDAR),1.6) | String.StartsWith(Player.Process(VideoDAR),1.7) | String.StartsWith(Player.Process(VideoDAR),1.8) | String.StartsWith(Player.Process(VideoDAR),1.9) | String.StartsWith(Player.Process(VideoDAR),2.0) | String.StartsWith(Player.Process(VideoDAR),2.1)]</expression>

	<!-- Zoom-in steps 25+ only apply to the buckets whose target needs them (see table above) -->
	<expression name="AutoZoomIn25">Skin.HasSetting(enableAutoZoom) + !String.IsEqual(Skin.String(autozoomfile),Player.Filenameandpath) + [[Skin.HasSetting(scopeFormat235) + [String.StartsWith(Player.Process(VideoDAR),1.0) | String.StartsWith(Player.Process(VideoDAR),1.1) | String.StartsWith(Player.Process(VideoDAR),1.2) | String.StartsWith(Player.Process(VideoDAR),1.3) | String.StartsWith(Player.Process(VideoDAR),1.4) | String.StartsWith(Player.Process(VideoDAR),1.5) | String.StartsWith(Player.Process(VideoDAR),1.6) | String.StartsWith(Player.Process(VideoDAR),1.7)]] | String.StartsWith(Player.Process(VideoDAR),1.8) | String.StartsWith(Player.Process(VideoDAR),1.9) | String.StartsWith(Player.Process(VideoDAR),2.0) | String.StartsWith(Player.Process(VideoDAR),2.1)]</expression>
	<expression name="AutoZoomIn27">Skin.HasSetting(enableAutoZoom) + !String.IsEqual(Skin.String(autozoomfile),Player.Filenameandpath) + [String.StartsWith(Player.Process(VideoDAR),1.8) | String.StartsWith(Player.Process(VideoDAR),1.9) | String.StartsWith(Player.Process(VideoDAR),2.0) | String.StartsWith(Player.Process(VideoDAR),2.1)]</expression>
	<expression name="AutoZoomIn28">Skin.HasSetting(enableAutoZoom) + !String.IsEqual(Skin.String(autozoomfile),Player.Filenameandpath) + [[Skin.HasSetting(scopeFormat235) + String.StartsWith(Player.Process(VideoDAR),1.8)] | String.StartsWith(Player.Process(VideoDAR),1.9) | String.StartsWith(Player.Process(VideoDAR),2.0) | String.StartsWith(Player.Process(VideoDAR),2.1)]</expression>
	<expression name="AutoZoomIn30">Skin.HasSetting(enableAutoZoom) + !String.IsEqual(Skin.String(autozoomfile),Player.Filenameandpath) + [String.StartsWith(Player.Process(VideoDAR),1.9) | String.StartsWith(Player.Process(VideoDAR),2.0) | String.StartsWith(Player.Process(VideoDAR),2.1)]</expression>
	<expression name="AutoZoomIn32">Skin.HasSetting(enableAutoZoom) + !String.IsEqual(Skin.String(autozoomfile),Player.Filenameandpath) + [[Skin.HasSetting(scopeFormat235) + String.StartsWith(Player.Process(VideoDAR),1.9)] | String.StartsWith(Player.Process(VideoDAR),2.0) | String.StartsWith(Player.Process(VideoDAR),2.1)]</expression>
	<expression name="AutoZoomIn34">Skin.HasSetting(enableAutoZoom) + !String.IsEqual(Skin.String(autozoomfile),Player.Filenameandpath) + [String.StartsWith(Player.Process(VideoDAR),2.0) | String.StartsWith(Player.Process(VideoDAR),2.1)]</expression>
	<expression name="AutoZoomIn36">Skin.HasSetting(enableAutoZoom) + !String.IsEqual(Skin.String(autozoomfile),Player.Filenameandpath) + [[Skin.HasSetting(scopeFormat235) + String.StartsWith(Player.Process(VideoDAR),2.0)] | String.StartsWith(Player.Process(VideoDAR),2.1)]</expression>
	<expression name="AutoZoomIn38">Skin.HasSetting(enableAutoZoom) + !String.IsEqual(Skin.String(autozoomfile),Player.Filenameandpath) + String.StartsWith(Player.Process(VideoDAR),2.1)</expression>
	<expression name="AutoZoomIn41">Skin.HasSetting(enableAutoZoom) + !String.IsEqual(Skin.String(autozoomfile),Player.Filenameandpath) + Skin.HasSetting(scopeFormat235) + String.StartsWith(Player.Process(VideoDAR),2.1)</expression>

	<include name="AutoZoomOut10">
		<onload condition="$EXP[AutoZoomRun]">Action(zoomout)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomout)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomout)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomout)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomout)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomout)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomout)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomout)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomout)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomout)</onload>
	</include>
	<include name="AutoZoomIn8">
		<onload condition="$EXP[AutoZoomRun]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomRun]">Action(zoomin)</onload>
	</include>

	<include name="AutoZoom">
		<!-- 1. 150 x zoomout: from any zoom (Kodi max is 2.00) this lands exactly on the 0.50 minimum -->
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<include>AutoZoomOut10</include>
		<!-- 2. zoomin steps 1-24: every bucket (0.50 -> 0.74) -->
		<include>AutoZoomIn8</include>
		<include>AutoZoomIn8</include>
		<include>AutoZoomIn8</include>
		<!-- 3. zoomin steps 25-41: only the buckets that need more -->
		<onload condition="$EXP[AutoZoomIn25]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn25]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn27]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn28]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn28]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn30]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn30]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn32]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn32]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn34]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn34]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn36]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn36]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn38]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn38]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn38]">Action(zoomin)</onload>
		<onload condition="$EXP[AutoZoomIn41]">Action(zoomin)</onload>
		<!-- 4. remember this file so re-entering fullscreen doesn't redo it -->
		<onload condition="$EXP[AutoZoomRun]">Skin.SetString(autozoomfile,"$INFO[Player.Filenameandpath]")</onload>
	</include>

	<!--
		OSD button actions (VideoOSD.xml). Same idea as AutoZoom: clamp to 0.50 first, then zoom in
		to an absolute value, so pressing a button twice gives the same result.
	-->
	<include name="ZoomClickOut10">
		<onclick>Action(zoomout)</onclick>
		<onclick>Action(zoomout)</onclick>
		<onclick>Action(zoomout)</onclick>
		<onclick>Action(zoomout)</onclick>
