		<onclick>Action(zoomin)</onclick>
		<onclick>Action(zoomin)</onclick>
		<onclick>Action(zoomin)</onclick>
	</include>
	<!-- 150 x zoomout: lands on 0.50 from anywhere -->
	<include name="ZoomClickToMin">
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
		<include>ZoomClickOut10</include>
	</include>
	<!-- Zoom in button: back to 1.00 (e.g. scope movies with the black bars encoded in a 16:9 frame) -->
	<include name="ZoomClickFull">
		<include>ZoomClickToMin</include>
		<include>ZoomClickIn8</include>
		<include>ZoomClickIn8</include>
		<include>ZoomClickIn8</include>
		<include>ZoomClickIn8</include>
		<include>ZoomClickIn8</include>
		<include>ZoomClickIn8</include>
		<onclick>Action(zoomin)</onclick>
		<onclick>Action(zoomin)</onclick>
	</include>
	<!-- Zoom out button: fit a 16:9 frame inside the scope frame, 0.74 (2.40) or 0.76 (2.35) -->
	<include name="ZoomClickScopeFit">
		<include>ZoomClickToMin</include>
		<include>ZoomClickIn8</include>
		<include>ZoomClickIn8</include>
		<include>ZoomClickIn8</include>
		<onclick condition="Skin.HasSetting(scopeFormat235)">Action(zoomin)</onclick>
		<onclick condition="Skin.HasSetting(scopeFormat235)">Action(zoomin)</onclick>
	</include>

	<!-- Subtitle buttons: move subtitles 110 steps up into / down out of the scope frame -->
